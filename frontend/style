body {
    margin: 0;
    overflow: hidden;
    font-family: 'Courier New', monospace;
    background: #050b1a;
}

#info {
    position: absolute;
    top: 20px;
    left: 20px;
    background: rgba(0,0,0,0.6);
    color: #0f0;
    padding: 10px;
    border-radius: 8px;
    z-index: 100;
    pointer-events: none;
}

#command {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 300px;
    background: rgba(0,0,0,0.7);
    padding: 10px;
    border-radius: 8px;
    z-index: 100;
}

#auth-panel {
    position: absolute;
    top: 20px;
    right: 20px;
    background: rgba(0,0,0,0.7);
    padding: 10px;
    border-radius: 8px;
    z-index: 100;
}

input, button {
    background: #111;
    color: #0f0;
    border: 1px solid #0f0;
    padding: 5px;
    margin: 2px;
    font-family: 'Courier New', monospace;
}

button:hover {
    background: #0f0;
    color: #111;
    cursor: pointer;
}

#cmdOutput {
    font-size: 10px;
    color: #aaa;
    margin-top: 5px;
    max-height: 100px;
    overflow-y: auto;
}

#threeCanvas {
    display: block;
    width: 100vw;
    height: 100vh;
}
