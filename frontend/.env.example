# Kai EL OS / Command Center (React frontend) — build-time env config
#
# Vite only exposes vars prefixed VITE_ to client code (see vite.config.ts).
# Copy this file to .env (gitignored) and fill in real values before building.
#   cp .env.example .env

VITE_API_BASE_URL=
VITE_ARENA_WS_URL=

# Sentry error tracking (task 4, 2026-08-02). initSentry() in
# src/services/sentry.ts is a genuine no-op with this unset — no DSN, no
# Sentry network calls, no crash. Founder-supplied only, get a real DSN from
# sentry.io — never commit a real value into this example file.
VITE_SENTRY_DSN=
VITE_APP_VERSION=
