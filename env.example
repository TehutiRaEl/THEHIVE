# REQUIRED — These must be set explicitly. No auto-generated fallbacks.
JASPER_API_KEY=change_this_to_a_random_32_char_string
JWT_SECRET_KEY=change_this_to_another_random_32_char_string

# LLM
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3:8b
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=

# Economy
SOUL_TO_USD_RATE=0.10
STAKING_APY=0.05
DOUBLING_THRESHOLD=0.707
TRUST_SPLIT=0.10
TREASURY_SPLIT=0.20
AGENT_SPLIT=0.70

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# CORS
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Phase Control
HIVE_PHASE=0
ENABLE_GUILDS=constitutional,audit,treasury

# Docker Resource Limits (Oracle Cloud Free Tier friendly)
OLLAMA_CPU_LIMIT=2
OLLAMA_MEM_LIMIT=8G
BACKEND_CPU_LIMIT=2
BACKEND_MEM_LIMIT=8G
