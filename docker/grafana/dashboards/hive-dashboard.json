{
  "title": "Sovereign Hive Dashboard",
  "uid": "hive-v11",
  "version": 1,
  "panels": [
    {
      "title": "Hive Resonance",
      "type": "gauge",
      "targets": [
        {
          "expr": "jasper_hive_resonance",
          "legendFormat": "Resonance ρ"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "green", "value": 0.707}
            ]
          }
        }
      }
    },
    {
      "title": "Active Agents",
      "type": "stat",
      "targets": [
        {
          "expr": "jasper_active_agents",
          "legendFormat": "Agents"
        }
      ]
    },
    {
      "title": "LLM Requests",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(jasper_llm_requests_total[5m])",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "title": "SOUL Transfers",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(jasper_soul_transfers_total[5m])",
          "legendFormat": "{{from_agent}} → {{to_agent}}"
        }
      ]
    },
    {
      "title": "Arena Battles",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(jasper_arena_battles_total[5m])",
          "legendFormat": "{{winner}}"
        }
      ]
    },
    {
      "title": "WebSocket Connections",
      "type": "stat",
      "targets": [
        {
          "expr": "jasper_websocket_connections",
          "legendFormat": "Connections"
        }
      ]
    }
  ]
}
