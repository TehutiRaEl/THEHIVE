// THEHIVE — one worker, whole hive: serves the Command Center (docs/) as
// static assets AND the /v11 API (worker/src/index.js) against the
// thehive-queen D1 database. Same origin — no CORS, no ?backend= needed.
// Deployed by Cloudflare Workers Builds on every push to main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thehive",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  "assets": { "directory": "docs", "binding": "ASSETS" },
  // the heartbeat: every 30 minutes the Queen acts on her own —
  // resolves pending arena challenges, projects the battle, spawns the next
  "triggers": { "crons": ["*/30 * * * *"] },
  // Workers AI (free allocation) writes the propositions AND the memory
  // embeddings (@cf/baai/bge-base-en-v1.5); code falls back gracefully when unbound
  "ai": { "binding": "AI" },
  // Sovereign memory: semantic recall over the hive's own history.
  // ⚠️ BINDING IS COMMENTED OUT ON PURPOSE. A vectorize binding pointing at an
  // index that doesn't exist yet FAILS the deploy at build time — which would
  // take the live Queen (heartbeat + API) down. So the worker code ships now and
  // no-ops (memory/status → vectorize_bound:false) until the index is created.
  // ACTIVATED 2026-08-03: index created (npx wrangler vectorize create
  // hive-memory --dimensions=768 --metric=cosine), binding uncommented below.
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "hive-memory" }
  ],
  // Files store (the real backend for the Files panel). Same flip-the-switch
  // pattern as Vectorize: a binding to a bucket that doesn't exist fails the
  // deploy, so it ships commented and /v11/files reports available:false.
  // ACTIVATED 2026-08-03: bucket created (npx wrangler r2 bucket create
  // hive-files), binding uncommented below.
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "hive-files" }
  ],
  // Rate-limit counters (Phase 8, 2026-07-21). FLIPPED 2026-07-23 at the
  // founder's go: namespace created via the Cloudflare MCP connector,
  // rateLimitOk() now uses KV (same 30/min/IP limit as the D1 fallback it
  // replaces — no caller-visible change, just faster).
  "kv_namespaces": [
    { "binding": "RATE_LIMIT_KV", "id": "7ca8178dc4bc40e7bac193362e3d6be4" }
  ],
  // Async LLM jobs (Phase 8, 2026-07-21). Same flip-the-switch pattern: a
  // queues binding pointing at a queue that doesn't exist fails the deploy,
  // so it ships commented. Until activated, POST /v11/venture/plan and
  // POST /v11/legal/research simply ignore {"async": true} and answer
  // synchronously as they always have — nothing breaks either way.
  // ACTIVATED 2026-08-03: queue created (npx wrangler queues create
  // hive-llm-jobs), binding uncommented below IN THE SAME COMMIT as
  // re-attaching `queue: processQueueBatch` in worker/src/index.js's
  // export default — see the comment there for why these two must move
  // together (PR_LESSONS.md L-08, the 2026-07-21/22 outage).
  "queues": {
    "producers": [
      { "binding": "LLM_QUEUE", "queue": "hive-llm-jobs" }
    ],
    "consumers": [
      { "queue": "hive-llm-jobs", "max_batch_size": 5, "max_retries": 3 }
    ]
  },
  // Real-time Command Center push (task 14, 2026-08-17). Unlike Vectorize/R2/
  // Queues above, a Durable Object needs no out-of-band `wrangler ... create`
  // step — the migration below is what registers the class at deploy time, so
  // this binds and migrates in the same commit as the class export in
  // worker/src/index.js rather than shipping commented-out first.
  "durable_objects": {
    "bindings": [
      { "name": "COMMAND_CENTER", "class_name": "CommandCenterDO" }
    ]
  },
  "migrations": [
    { "tag": "v1-command-center-do", "new_sqlite_classes": ["CommandCenterDO"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thehive-queen",
      "database_id": "70212689-5633-4c09-9e1d-ae6294ce19eb"
    },
    // Kai El's own brain (2026-08-10, founder-directed). A physically separate
    // database rather than more tables in thehive-queen — the founder was shown
    // the tradeoff (a separate DB costs one of the account's 10 D1 slots, and the
    // pattern does not scale to 13 agents x 2 databases) and chose it anyway,
    // specifically for Kai El as the hive's second brain. Nanuet, the first brain,
    // gets the same treatment later when work on the Queen resumes.
    //
    // Schema: worker/schema/kai-el-brain.sql (memories, decision_log,
    // training_samples, autonomy_registry). Created and applied for real via the
    // Cloudflare connector on 2026-08-10, not just declared here.
    //
    // UNLIKE Vectorize/R2/Queues above, this binding is NOT commented out: the
    // database genuinely exists, so binding it cannot fail the deploy. Every read
    // and write still goes through kaiBrainOk()/env.KAI_BRAIN guards in
    // worker/src/index.js, so an unbound or unreachable brain degrades to the
    // exact behaviour Kai El has today rather than breaking him.
    {
      "binding": "KAI_BRAIN",
      "database_name": "kai-el-brain",
      "database_id": "7c62dea9-64ba-4d38-a5bf-234d5a504f19"
    }
  ],
  // FOUNDER_KEY moved to Cloudflare's Secrets Store (an account-wide vault,
  // distinct from a classic per-Worker secret set via `wrangler secret put`)
  // 2026-08-08 at the founder's choice — "secrets store was easier to find
  // and less of a ache moving forward." A secrets_store_secrets binding
  // resolves at runtime to an object with an async .get() method, NOT a
  // plain string like a classic secret, so every read site in
  // worker/src/index.js goes through resolveSecret()/founderKeyBound()
  // rather than a bare truthy/equality check. store_id is the founder's own
  // Secrets Store, confirmed from their Cloudflare dashboard.
  "secrets_store_secrets": [
    {
      "binding": "FOUNDER_KEY",
      "store_id": "88799ba02bfb497b830a1bf0e337467a",
      "secret_name": "FOUNDER_KEY"
    }
  ]
  // Cloudflare Access — a second, key-free way for the founder's own browser to
  // authenticate (2026-08-09), additive alongside FOUNDER_KEY above (which stays
  // exactly as-is for CI and as a browser fallback). Same flip-the-switch pattern
  // as Vectorize/R2/Queues above: with these three vars unset, verifyAccessJWT()
  // in worker/src/index.js fails closed on every request, so the new
  // /v11/founder/* routes simply 401 (falling back to the FOUNDER_KEY UI) until
  // the founder finishes Step 0 (FLIP_THE_SWITCHES.md) — creating the Access
  // Application in the Zero Trust dashboard, protecting the /v11/founder/* path
  // — and fills these in from what that step produces:
  //   ACCESS_TEAM_DOMAIN — "<your-team-name>.cloudflareaccess.com"
  //   ACCESS_AUD         — the Access Application's Audience (AUD) tag
  //   FOUNDER_EMAIL      — the one email allow-listed in the Access policy
  // None of these three are secret (an audience tag and an email address aren't
  // sensitive the way a password is), so they're plain vars, not a secret store.
  // Once Step 0 is done: add a "," after the "]" that closes
  // secrets_store_secrets above, then uncomment and fill in this block —
  // "vars": {
  //   "ACCESS_TEAM_DOMAIN": "<your-team-name>.cloudflareaccess.com",
  //   "ACCESS_AUD": "<the Access Application's Audience tag>",
  //   "FOUNDER_EMAIL": "<the founder's own allow-listed email>"
  // }
}
