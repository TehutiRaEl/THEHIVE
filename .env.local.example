# Sovereign Hive v11.0 – Environment Variables

# ─── Required ──────────────────────────────────────────────
JASPER_API_KEY=change_this_to_a_random_64_char_string
JWT_SECRET_KEY=change_this_to_another_random_64_char_string

# ─── LLM Router ────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=

# ─── Economy ────────────────────────────────────────────────
SOUL_TO_USD_RATE=0.10
STAKING_APY=0.05
DOUBLING_THRESHOLD=0.707
DECAY_RATE=0.95                     # Prevents hyperinflation

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ─── Phase Control ──────────────────────────────────────────
HIVE_PHASE=0
ENABLE_GUILDS=constitutional,audit,treasury

# ─── SOUL Token (Optional) ──────────────────────────────────
SOUL_CONTRACT_ADDRESS=
SOUL_TREASURY_ADDRESS=
SEPOLIA_RPC_URL=

# ─── Tier 3: Quantum Bridge ─────────────────────────────────
IBMQ_TOKEN=                          # IBM Quantum API token

# ─── Tier 3: IPFS PubSub ────────────────────────────────────
IPFS_API_URL=http://localhost:5001

# ─── Database ────────────────────────────────────────────────
DB_PATH=jasper_memory.db
CHROMA_PATH=./chroma_db
