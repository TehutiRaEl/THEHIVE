# Sovereign Hive – Environment Variables

# Required
JWT_SECRET_KEY=change_this_to_a_random_64_char_string
JASPER_API_KEY=change_this_to_another_random_64_char_string

# LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=

# Economy
SOUL_TO_USD_RATE=0.10
STAKING_APY=0.05
DOUBLING_THRESHOLD=0.707

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# CORS
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Phase Control
HIVE_PHASE=0
ENABLE_GUILDS=constitutional,audit,treasury

# SOUL Token (optional)
SOUL_CONTRACT_ADDRESS=
SOUL_TREASURY_ADDRESS=
SEPOLIA_RPC_URL=

# Tier 3
IBMQ_TOKEN=
IPFS_API_URL=http://localhost:5001
