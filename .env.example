# Sovereign Hive — Queen (THEHIVE) environment configuration
#
# ⚠️ NEVER put real key/secret VALUES in this file. It is a committed, public
# template — anything typed here becomes visible to the entire internet the
# moment it's pushed (this repo is public). This file previously had a real
# GROK_API_KEY and MISTRAL_API_KEY value committed directly to main; both were
# exposed and must be treated as compromised — rotate them at
# console.groq.com and console.mistral.ai regardless of anything else.
#
# This file also has NO effect on the live Cloudflare Worker (System B) no
# matter what's filled in — Workers never read .env files. See
# `.dev.vars.example` + `FLIP_THE_SWITCHES.md` for how the Worker's real LLM
# keys actually get bound (`npx wrangler secret put <NAME>`, never a file).
#
# Copy this file to .env (gitignored) and generate real secrets before
# deploying System A locally:
#   cp .env.example .env
#   sed -i "s/^JASPER_API_KEY=.*/JASPER_API_KEY=$(openssl rand -hex 32)/" .env
#   sed -i "s/^JWT_SECRET_KEY=.*/JWT_SECRET_KEY=$(openssl rand -hex 32)/" .env
#
# NOTE: .env files are NOT shell-evaluated by Docker — a literal
# "$(openssl rand -hex 32)" placed in .env is read as that literal string,
# not executed. Generate the values in your shell first, then paste them in.

GROK_API_KEY=
MISTRAL_API_KEY=
JASPER_API_KEY=
JWT_SECRET_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
LLM_PROVIDER=ollama

# ============================================
# COLONY URLS (for HiveMesh dispatch / federation)
# ============================================
LOCALAGI_URL=http://localhost:8080
NAR2_URL=http://localhost:8000
FOURDBRAIN_URL=http://localhost:8000
AETHER_URL=http://localhost:3000
AUTOMATISCH_URL=http://localhost:3001
KIMI_K2_URL=http://localhost:8002

# ============================================
# docker-compose.federation.yml variable substitution
# (these are read by THEHIVE's own compose invocation, not by other colonies)
# ============================================
AUTOMATISCH_DB_PASSWORD=hivepass
GRAFANA_PASSWORD=hivegraf
