# Sovereign Hive — System A (backend/, FastAPI + Docker) environment configuration.
#
# ⚠️ SCOPE, READ BEFORE EDITING: this file is for System A (backend/, the FastAPI
# app + docker-compose.federation.yml) only. System A has never been verified
# deployed anywhere live — see CLAUDE.md's "What is NOT yet reconciled" section.
#
# This file has NO effect on the live, actually-serving-production system
# (System B — the Cloudflare Worker at thehive.sovereignhive.workers.dev).
# Cloudflare Workers do not read .env files at all, in dev or production —
# they read secrets via `npx wrangler secret put <NAME>` (production) or a
# gitignored `.dev.vars` file (local `wrangler dev`). If you want the Worker's
# own LLM provider keys (Claude/Groq/Mistral) actually calling out for real,
# see `.dev.vars.example` (repo root, next to this file) and `FLIP_THE_SWITCHES.md`
# — not this file. Confirmed live via `GET /v11/llm/status` and the
# `edge-health-probe` GitHub Actions workflow, which now probes that endpoint
# on every run (added 2026-07-21) — this repo cannot curl *.workers.dev
# directly (egress-blocked), so that workflow is the real, standing way to
# verify which provider is actually bound, not a local .env file.
#
# Copy this file to .env and generate real secrets before deploying System A:
#   cp .env.example .env
#   sed -i "s/^JASPER_API_KEY=.*/JASPER_API_KEY=$(openssl rand -hex 32)/" .env
#   sed -i "s/^JWT_SECRET_KEY=.*/JWT_SECRET_KEY=$(openssl rand -hex 32)/" .env
#
# NOTE: .env files are NOT shell-evaluated by Docker — a literal
# "$(openssl rand -hex 32)" placed in .env is read as that literal string,
# not executed. Generate the values in your shell first, then paste them in.

JASPER_API_KEY=
JWT_SECRET_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
LLM_PROVIDER=ollama

# ============================================
# COLONY URLS (for HiveMesh dispatch / federation)
# ============================================
LOCALAGI_URL=http://localhost:8080
NAR2_URL=http://localhost:8000
FOURDBRAIN_URL=http://localhost:8000
AETHER_URL=http://localhost:3000
AUTOMATISCH_URL=http://localhost:3001
KIMI_K2_URL=http://localhost:8002

# ============================================
# docker-compose.federation.yml variable substitution
# (these are read by THEHIVE's own compose invocation, not by other colonies)
# ============================================
AUTOMATISCH_DB_PASSWORD=hivepass
GRAFANA_PASSWORD=hivegraf
