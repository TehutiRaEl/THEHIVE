import React, { Component, ErrorInfo, ReactNode } from 'react';
import * as Sentry from '@sentry/react';
import { captureException } from '@sentry/react';
import { useUiStore } from '../stores/uiStore';
import { ConstitutionalCheck, F_001, F_004, F_006 } from '../types/constitution';
import { ErrorBoundaryProps, ErrorBoundaryState, ErrorFallbackProps } from '../types/ui';

/**
 * ErrorFallback Component - Displayed when errors occur
 * Integrates with constitutional design system (F-004: Explainability)
 */
export const ErrorFallback: React.FC<ErrorFallbackProps> = ({
  error,
  componentStack,
  resetErrorBoundary,
  constitutionalViolations = [],
}) => {
  const { addNotification, setModal } = useUiStore.getState();

  const handleReset = () => {
    resetErrorBoundary();
    addNotification({
      id: `reset-${Date.now()}`,
      type: 'success',
      title: 'System Restored',
      message: 'Error boundary reset successfully',
      duration: 5000,
    });
  };

  const handleReport = () => {
    captureException(error, {
      contexts: {
        constitution: {
          violations: constitutionalViolations,
          checks: ['F-001', 'F-004', 'F-006'].filter(check =>
            constitutionalViolations.includes(check as ConstitutionalCheck)
          ),
        },
      },
    });

    addNotification({
      id: `report-${Date.now()}`,
      type: 'info',
      title: 'Error Reported',
      message: 'Error details sent to Sentry for analysis',
      duration: 3000,
    });
  };

  // Auto-fix attempts for known error patterns (Self-Healing Interface)
  const attemptAutoFix = () => {
    const errorMessage = error?.message || '';

    // F-001: Data Sovereignty - Check for localStorage issues
    if (errorMessage.includes('localStorage') || errorMessage.includes('QuotaExceededError')) {
      addNotification({
        id: `autofix-${Date.now()}`,
        type: 'warning',
        title: 'Storage Issue Detected',
        message: 'Clearing expired data...',
        duration: 2000,
      });

      try {
        const keysToRemove: string[] = [];
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (key && (key.startsWith('hive-') || key.startsWith('colony-'))) {
            const item = localStorage.getItem(key);
            if (item) {
              const parsed = JSON.parse(item);
              if (parsed?.expiresAt && parsed.expiresAt < Date.now()) {
                keysToRemove.push(key);
              }
            }
          }
        }
        keysToRemove.forEach(key => localStorage.removeItem(key));

        addNotification({
          id: `autofix-success-${Date.now()}`,
          type: 'success',
          title: 'Storage Cleaned',
          message: `Removed ${keysToRemove.length} expired items`,
          duration: 3000,
        });

        return true;
      } catch (fixError) {
        captureException(fixError, { contexts: { autoFix: { type: 'localStorage' } } });
        return false;
      }
    }

    // F-006: Non-Penalization - Check for rate limiting
    if (errorMessage.includes('rate limit') || errorMessage.includes('429')) {
      addNotification({
        id: `rate-limit-${Date.now()}`,
        type: 'warning',
        title: 'Rate Limit Detected',
        message: 'Retrying with exponential backoff...',
        duration: 2000,
      });
      return true;
    }

    return false;
  };

  // Attempt auto-fix on mount
  React.useEffect(() => {
    const fixed = attemptAutoFix();
    if (fixed) {
      setTimeout(() => {
        resetErrorBoundary();
      }, 2000);
    }
  }, []);

  return (
    <div className="hive-error-boundary" role="alert" aria-live="assertive">
      <div className="error-overlay">
        <div className="error-container glass-panel">
          <div className="error-header">
            <h2 className="error-title">
              <span className="error-icon">⚠️</span>
              System Anomaly Detected
            </h2>
            <div className="error-severity">
              {constitutionalViolations.length > 0 ? (
                <span className="severity-high">CONSTITUTIONAL BREACH</span>
              ) : (
                <span className="severity-medium">SYSTEM ERROR</span>
              )}
            </div>
          </div>

          <div className="error-content">
            <div className="error-message">
              <p>{error?.message || 'An unexpected error occurred in the Hive'}</p>
              {constitutionalViolations.length > 0 && (
                <div className="constitutional-violations">
                  <h4>Constitutional Violations:</h4>
                  <ul>
                    {constitutionalViolations.map((violation, index) => (
                      <li key={index} className="violation-item">
                        <span className="violation-badge">{violation}</span>
                        <span className="violation-desc">
                          {violation === F_001 && 'Data Sovereignty compromised'}
                          {violation === F_004 && 'Explainability failure'}
                          {violation === F_006 && 'Non-Penalization violation'}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            {componentStack && (
              <details className="error-details">
                <summary>Technical Details</summary>
                <pre className="error-stack">{componentStack}</pre>
              </details>
            )}
          </div>

          <div className="error-actions">
            <button
              onClick={handleReset}
              className="btn btn-primary"
              aria-label="Reset error boundary"
            >
              <span className="btn-icon">🔄</span>
              Reset System
            </button>

            <button
              onClick={handleReport}
              className="btn btn-secondary"
              aria-label="Report error to Sentry"
            >
              <span className="btn-icon">📤</span>
              Report to Sentry
            </button>

            {process.env.NODE_ENV === 'development' && (
              <button
                onClick={() => {
                  setModal({
                    id: 'error-dev',
                    title: 'Developer Tools',
                    content: (
                      <div className="dev-tools">
                        <h3>Debug Information</h3>
                        <p><strong>Error:</strong> {error?.message}</p>
                        <p><strong>Stack:</strong> {componentStack?.substring(0, 200)}...</p>
                        <button onClick={() => navigator.clipboard.writeText(componentStack || '')}>
                          Copy Stack Trace
                        </button>
                      </div>
                    ),
                    isOpen: true,
                  });
                }}
                className="btn btn-tertiary"
              >
                <span className="btn-icon">🛠️</span>
                Dev Tools
              </button>
            )}
          </div>
        </div>
      </div>
    </div>
  );
};

/**
 * ErrorBoundary Component - Core reliability component
 * Implements constitutional design system (F-004: Explainability, F-006: Non-Penalization)
 * Integrates with Sentry for error tracking
 * Provides self-healing capabilities
 */
export class ErrorBoundary extends Component<ErrorBoundaryProps, ErrorBoundaryState> {
  private constitutionalChecks: ConstitutionalCheck[] = [F_001, F_004, F_006];
  private unmounted = false;

  constructor(props: ErrorBoundaryProps) {
    super(props);
    this.state = {
      hasError: false,
      error: null,
      errorInfo: null,
      constitutionalViolations: [],
      recoveryAttempts: 0,
      lastErrorTime: null,
    };
  }

  static getDerivedStateFromError(error: Error): Partial<ErrorBoundaryState> {
    return {
      hasError: true,
      error,
      errorInfo: null,
      lastErrorTime: new Date().toISOString(),
    };
  }

  componentDidCatch(error: Error, errorInfo: ErrorInfo): void {
    if (this.unmounted) return;

    const violations = this.checkConstitutionalViolations(error);

    captureException(error, {
      contexts: {
        constitution: {
          violations,
          checks: this.constitutionalChecks,
        },
        component: {
          name: errorInfo.componentStack.split('\n')[0],
        },
      },
    });

    this.setState({
      errorInfo,
      constitutionalViolations: violations,
      recoveryAttempts: this.state.recoveryAttempts + 1,
    });

    if (this.state.recoveryAttempts < 3) {
      this.attemptSelfHealing(error);
    }
  }

  componentWillUnmount(): void {
    this.unmounted = true;
  }

  private checkConstitutionalViolations(error: Error): ConstitutionalCheck[] {
    const violations: ConstitutionalCheck[] = [];
    const message = error.message.toLowerCase();

    if (message.includes('localstorage') ||
        message.includes('permission') ||
        message.includes('access denied') ||
        message.includes('quota')) {
      violations.push(F_001);
    }

    if (message.includes('undefined') ||
        message.includes('null') ||
        message.includes('cannot read') ||
        message.includes('typeerror')) {
      violations.push(F_004);
    }

    if (message.includes('rate limit') ||
        message.includes('429') ||
        message.includes('too many requests') ||
        message.includes('blocked')) {
      violations.push(F_006);
    }

    return violations;
  }

  private attemptSelfHealing(error: Error): void {
    const message = error.message.toLowerCase();

    // F-001: Data Sovereignty - Clean up corrupted localStorage
    if (message.includes('localstorage') || message.includes('quota')) {
      try {
        const hiveKeys = Object.keys(localStorage).filter(key =>
          key.startsWith('hive-') || key.startsWith('colony-') || key.startsWith('agent-')
        );

        hiveKeys.forEach(key => {
          try {
            const item = localStorage.getItem(key);
            if (item) JSON.parse(item);
          } catch {
            localStorage.removeItem(key);
          }
        });

        setTimeout(() => {
          if (!this.unmounted) {
            this.setState({ hasError: false, error: null, errorInfo: null });
          }
        }, 1000);
      } catch (cleanupError) {
        captureException(cleanupError, {
          contexts: { selfHealing: { type: 'localStorage cleanup' } }
        });
      }
    }

    // F-006: Non-Penalization - Implement retry logic
    if (message.includes('rate limit') || message.includes('429')) {
      const retryDelay = Math.min(1000 * Math.pow(2, this.state.recoveryAttempts), 30000);
      setTimeout(() => {
        if (!this.unmounted) {
          this.setState({ hasError: false, error: null, errorInfo: null });
        }
      }, retryDelay);
    }
  }

  resetErrorBoundary = (): void => {
    this.setState({
      hasError: false,
      error: null,
      errorInfo: null,
      constitutionalViolations: [],
      recoveryAttempts: 0,
    });
  };

  render(): ReactNode {
    const { children, fallback: FallbackComponent = ErrorFallback } = this.props;
    const { hasError, error, errorInfo, constitutionalViolations } = this.state;

    if (hasError) {
      return (
        <FallbackComponent
          error={error}
          componentStack={errorInfo?.componentStack || ''}
          resetErrorBoundary={this.resetErrorBoundary}
          constitutionalViolations={constitutionalViolations}
        />
      );
    }

    return children;
  }
}

/**
 * Higher-Order Component for constitutional compliance
 */
export const withConstitutionalSafety = <P extends object>(
  Component: React.ComponentType<P>,
  constitutionalChecks: ConstitutionalCheck[] = [F_001, F_004, F_006]
) => {
  const WrappedComponent: React.FC<P> = (props) => (
    <ErrorBoundary constitutionalChecks={constitutionalChecks}>
      <Component {...props} />
    </ErrorBoundary>
  );

  const componentName = Component.displayName || Component.name || 'Component';
  WrappedComponent.displayName = `withConstitutionalSafety(${componentName})`;

  return WrappedComponent;
};

/**
 * Sentry Error Boundary - Pre-configured for production
 */
export const SentryErrorBoundary: React.FC<{
  children: ReactNode;
  fallback?: React.ComponentType<ErrorFallbackProps>;
}> = ({ children, fallback }) => (
  <ErrorBoundary fallback={fallback}>
    {children}
  </ErrorBoundary>
);

export default ErrorBoundary;
