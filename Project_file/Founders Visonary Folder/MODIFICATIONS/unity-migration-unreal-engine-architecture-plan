    [ServerRpc]
    public void BuildCastleServerRpc(string guildId, string leaderId, Vector3 position, CastleType type)
    {
        var guild = GuildManager.Instance.Guilds[guildId];
        
        // Validate leader
        if (guild.LeaderId != leaderId) return;
        
        // Check requirements
        if (!CanBuildCastle(guild, type)) return;
        
        // Check position
        if (!IsValidCastlePosition(position)) return;
        
        // Build
        var castle = new Castle
        {
            Id = Guid.NewGuid().ToString(),
            Name = $"{guild.Name}'s {type}",
            GuildId = guildId,
            Position = position,
            Type = type,
            Level = 1,
            Health = 1000 * (int)type,
            MaxHealth = 1000 * (int)type
        };
        
        Castles.Add(castle.Id, castle);
        guild.CastleId = castle.Id;
        
        // Spawn in world
        SpawnCastle(castle);
    }
    
    [ServerRpc]
    public void AttackCastleServerRpc(string attackerGuildId, string defenderCastleId)
    {
        var castle = Castles[defenderCastleId];
        var attackerGuild = GuildManager.Instance.Guilds[attackerGuildId];
        
        // Validate
        if (!CanAttackCastle(attackerGuild, castle)) return;
        
        // Start siege
        StartSiege(attackerGuildId, defenderCastleId);
    }
}
