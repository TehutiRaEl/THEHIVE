+// ── Dual Lens helpers (feat/lens-perception-layer) ───────────────────────
+async function reviewProposal(env, proposal) {
+  const voice = await loadVoice(env);
+  const system = SEER.instruction + '\n\nVOICE.md:\n' + (voice || '(VOICE.md not yet populated — refuse until first compression)');
+  const gen = await generate(env, {
+    system,
+    prompt: 'Review this proposal and return ONLY the JSON object specified in your instructions.\n\n' + JSON.stringify(proposal),
+    maxTokens: 400,
+    prefer: SEER.prefer || 'reasoning',
+  });
+  if (!gen?.text) {
+    return { verdict: 'refuse', failing_question: 'seer-empty', reason: 'seer returned no text' };
+  }
+  try {
+    const m = gen.text.match(/\{[\s\S]*\}/);
+    return JSON.parse(m ? m[0] : gen.text);
+  } catch {
+    return { verdict: 'refuse', failing_question: 'seer-parse', reason: 'seer returned unparseable output' };
+  }
+}
+
+async function safeCreateProposal(env, DB, proposal, insertFn) {
+  const gate = await createGate(env, DB, proposal);
+  if (!gate.ok) {
+    await logGateRefusal(env, DB, gate, proposal);
+    return { ok: false, ...gate };
+  }
+  await insertFn(gate.normalized_title);
+  return { ok: true, normalized_title: gate.normalized_title };
+}
